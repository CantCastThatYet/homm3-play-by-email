<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:HeroesLobby.Desktop" x:Class="HeroesLobby.Desktop.MainWindow"
        Title="Heroes Post" Width="1180" Height="800" MinWidth="980" MinHeight="680">
  <Grid ColumnDefinitions="250,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" Background="#14221E" BorderBrush="#2A3C32" BorderThickness="0,0,1,0" Padding="22,28">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="7">
          <TextBlock Text="H / P" Foreground="#D2B575" FontSize="33" FontWeight="Light" LetterSpacing="5"/>
          <TextBlock Text="HEROES POST" FontWeight="SemiBold" FontSize="18" LetterSpacing="2"/>
          <TextBlock Text="A place for the next turn." Classes="muted" FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,42,0,0" Spacing="12">
          <TextBlock Text="YOUR CONNECTION" Classes="eyebrow"/>
          <StackPanel><TextBlock Text="Server address" Classes="label"/><TextBox x:Name="ServerAddress" PlaceholderText="https://your-server.example"/></StackPanel>
          <StackPanel><TextBlock Text="Player name" Classes="label"/><TextBox x:Name="PlayerName" PlaceholderText="How friends know you" MaxLength="32"/></StackPanel>
          <Button x:Name="ConnectButton" Content="Connect to server" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ConnectClick"/>
          <TextBlock x:Name="ConnectionState" Text="Not connected" Classes="muted" TextWrapping="Wrap" FontSize="12"/>
          <Button x:Name="NativeSetupButton" Content="Set up HotA" Click="NativeSetupClick"/>
          <TextBlock x:Name="SetupState" Text="Set up HotA to play from this app." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="9"><TextBlock Text="BRING YOUR OWN SERVER" Classes="eyebrow" FontSize="10"/><TextBlock Text="Independent communities.&#10;One familiar gathering place." Classes="muted" FontSize="12" LineHeight="20"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,27,30,18" RowDefinitions="Auto,Auto,Auto,Auto,*">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="8"><TextBlock Text="YOUR GAMES" Classes="eyebrow"/><TextBlock Text="Play HotA with your friends." FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="ServerName" Text="Connect to your community, then play." Classes="muted"/></StackPanel>
        <Button Grid.Column="1" x:Name="PlayButton" Content="▶  Play HotA" Classes="primary" IsEnabled="False" VerticalAlignment="Center" FontSize="16" Padding="22,12" Click="PlayClick"/>
      </Grid>
      <Border Grid.Row="1" x:Name="MessagePanel" IsVisible="False" Background="#49372B" CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
        <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#F8DCA8" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Classes="quiet" Padding="10,2" Click="DismissClick"/></Grid>
      </Border>
      <Border Grid.Row="2" Classes="card" Padding="18,14" Margin="0,18,0,0">
        <StackPanel Spacing="6">
          <TextBlock Text="HOW IT WORKS" Classes="eyebrow" FontSize="10"/>
          <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Text="Play HotA opens your copy of HotA connected to this server. In HotA choose New Game, Multiplayer, TCP/IP, then Host or Join: everyone on this server sees the games hosted here. Turn on simultaneous turns in the game options and chat in HotA as usual."/>
          <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Classes="muted" Text="Keep this app open while you play: it saves your position on the server. After you end a turn you can close HotA. While you are away the server plays your seat: it finishes a turn you ended, and ends any other turn when the game's turn limit has passed. Come back with Continue."/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,22,0,10">
        <TextBlock x:Name="GameCount" Text="GAMES ON THIS SERVER" Classes="eyebrow" VerticalAlignment="Center"/>
        <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh" Classes="quiet" IsEnabled="False" Click="RefreshClick"/>
      </Grid>
      <Grid Grid.Row="4">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="GameList">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:RelayGameRow">
              <Border Classes="card" Padding="18,16" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Players}" Classes="muted" FontSize="12"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Continue" Classes="primary" IsVisible="{Binding CanContinue}" VerticalAlignment="Top" Click="ContinueClick"/>
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding State}" Foreground="#9DCAA8" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                  <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Saved}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Turn limit while away" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding LimitLabels}" SelectedIndex="{Binding LimitIndex, Mode=OneWay}" SelectionChanged="TurnLimitChanged"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="EmptyList" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Spacing="12" Margin="12">
          <TextBlock Text="◇" FontSize="42" Foreground="#C6AB70" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyTitle" Text="The hall awaits" FontSize="20" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyDescription" Text="Connect to a server to see your games." Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Border Grid.Column="1" Grid.Row="1" BorderBrush="#2A3C32" BorderThickness="0,1,0,0" Padding="30,12">
      <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="GameStatus" Text="HotA is not running." Classes="muted" FontSize="12" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="HEROES POST / 04" Classes="eyebrow" FontSize="10" Margin="16,0,0,0"/></Grid>
    </Border>
  </Grid>
</Window>
